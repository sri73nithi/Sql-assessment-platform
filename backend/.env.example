# Database connection URLs
# For local SQLite development (default zero-dependency mode):
DATABASE_URL=sqlite+aiosqlite:///./platform.db
SANDBOX_DATABASE_URL=sqlite:///./sandbox.db

# For PostgreSQL production mode (via Docker Compose):
# DATABASE_URL=postgresql+asyncpg://admin:admin_secure_password@localhost:5432/sql_assessment_platform
# SANDBOX_DATABASE_URL=postgresql://sandbox_admin:sandbox_admin_secure_password@localhost:5433/postgres

# JWT Security Configuration
JWT_SECRET=super_secret_jwt_key_for_sql_assessment_platform_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment: development, testing, or production
ENVIRONMENT=development

# Frontend application URL for CORS
FRONTEND_URL=http://localhost:3000

# Google Gemini AI API Key (Optional: fallbacks to rule-based grading if blank)
GEMINI_API_KEY=
